#include <stdio;

int main() {
    int vendas[3][4];
    int total_produto[3] = {0, 0, 0};
    int total_geral = 0;

    printf("Digite a qte do xº produto no yº dia:\n");


    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 4; j++) {
            scanf("%d", &vendas[i][j]);
            total_produto[i] += vendas[i][j]; 
        }
        total_geral += total_produto[i]; 
    }

    printf("\nSaída:\n");

    for (int i = 0; i < 3; i++) {
        printf("Produto %d: %d unidades\n", i + 1, total_produto[i]);
    }

  
    printf("Total geral: %d unidades\n", total_geral);

    return 0;
}
